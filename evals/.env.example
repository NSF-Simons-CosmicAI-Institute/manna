# Eval harness config. Copy to evals/.env (gitignored) and fill in real values.
# Auto-loaded by the eval entrypoints (evals/_env.py); real shell env vars override
# these, so you can still `EVAL_JUDGE_NAME=... uv run python -m evals.mcp_quality`.

# --- model under test -----------------------------------------------------------
# dlai01 Qwen3.5 via the datalab nginx proxy (Basic auth in the header).
EVAL_MODEL_NAME=Qwen/Qwen3.5-122B-A10B-FP8
EVAL_MODEL_BASE_URL=https://datalab.noirlab.edu/astro-archives-mcp
EVAL_MODEL_API_KEY=dummy
EVAL_MODEL_CUSTOM_HEADERS=Authorization: Basic <base64 of user:password>
EVAL_MODEL_LABEL=qwen3.5
# API shape: "anthropic" (default; Anthropic Messages API / vLLM native /v1/messages)
# or "openai" (OpenAI Chat Completions; OpenAI models + most open-weights endpoints).
EVAL_MODEL_BACKEND=anthropic

# --- judge ----------------------------------------------------------------------
# Option A: hosted Claude Haiku 4.5 (metered, ~pennies/run). Best JSON reliability.
EVAL_JUDGE_NAME=claude-haiku-4-5
EVAL_JUDGE_API_KEY=sk-ant-api03-REPLACE_ME
EVAL_JUDGE_LABEL=haiku-4.5-judge

# Option B: free self-hosted Qwen judge (~75-85% parseable). Comment Option A above,
# uncomment these:
# EVAL_JUDGE_NAME=Qwen/Qwen3.5-122B-A10B-FP8
# EVAL_JUDGE_BASE_URL=https://datalab.noirlab.edu/astro-archives-mcp
# EVAL_JUDGE_API_KEY=dummy
# EVAL_JUDGE_CUSTOM_HEADERS=Authorization: Basic <base64 of user:password>
# EVAL_JUDGE_LABEL=qwen3.5-judge

# --- optional run knobs (defaults shown) ----------------------------------------
# EVAL_MAX_STEPS=20
# EVAL_ASYNC_POLL_SLEEP=6
