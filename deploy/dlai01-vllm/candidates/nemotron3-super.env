# Nemotron 3 Super 120B-A12B FP8 (~120 GB) — hybrid Mamba-attention MoE.
# Ladder: TP=3 REFUSED at boot 2026-07-28 (32 attention heads % 3 != 0, same as Qwen).
# Now on rung 2: PP=3/TP=1. Remaining rungs: TP=2 -> NVFP4 checkpoint.
VLLM_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-FP8
# Nemotron 3 ships custom modeling code in its HF repo — the one candidate needing this.
VLLM_TRUST_FLAG=--trust-remote-code
VLLM_PP=3
VLLM_TP=1
VLLM_TOOL_PARSER=qwen3_coder
VLLM_REASONING_PARSER=nemotron_v3
VLLM_MAX_MODEL_LEN=131072
