# Gemma 4 31B instruction-tuned, dense (~62 GB BF16). TP=2 so KV for the
# 131072 window fits comfortably next to the weights.
# Known upstream bug to test at gate 6: gemma4 tool parser can emit <pad>
# tokens under concurrent requests (vllm-project/vllm #39392).
VLLM_MODEL=google/gemma-4-31B-it
VLLM_PP=1
VLLM_TP=2
VLLM_TOOL_PARSER=gemma4
VLLM_REASONING_PARSER=gemma4
VLLM_MAX_MODEL_LEN=131072
