# gpt-oss-120b MXFP4 (~63 GB) — fits a single GPU; TP=1 for the bake-off.
# (TP=3 impossible: 64 attention heads % 3 != 0. TP=2 is the latency/KV option
# for production if this candidate wins.)
VLLM_MODEL=openai/gpt-oss-120b
VLLM_PP=1
VLLM_TP=1
VLLM_TOOL_PARSER=openai
# vLLM's reasoning parser for the gpt-oss harmony format. If the image rejects
# this name, check `vllm serve --help` for the current gpt-oss parser name.
VLLM_REASONING_PARSER=openai_gptoss
VLLM_MAX_MODEL_LEN=131072
