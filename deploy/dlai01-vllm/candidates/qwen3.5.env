# OUTGOING production model (policy: decommissioned; delete this file at purge).
# PP=3/TP=1 because 32 attention heads don't divide by 3 (TP=3 refused at boot)
# but 48 layers / PP=3 = 16 per GPU is clean. Validated 2026-07-21.
VLLM_MODEL=Qwen/Qwen3.5-122B-A10B-FP8
VLLM_PP=3
VLLM_TP=1
VLLM_TOOL_PARSER=qwen3_coder
VLLM_REASONING_PARSER=qwen3
VLLM_MAX_MODEL_LEN=131072
