# All values are optional — defaults are fine for local dev.
# Prefix all env vars with MANNA_

MANNA_HOST=0.0.0.0
MANNA_PORT=8000
# Active archives (comma-separated short_names). Unset/empty => every archive
# in src/manna/archives/ except paused ones (nrao ships paused while NRAO
# rebuilds its TAP). Narrow a shared image, or re-enable a paused archive by name:
# MANNA_ARCHIVES=datalab,alma        # only these two make curated claims
# MANNA_ARCHIVES=datalab,alma,nrao   # nrao active despite being paused
MANNA_ARCHIVES=
MANNA_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
MANNA_TAP_SYNC_TIMEOUT_SECONDS=20.0
# count_observations_near_target: bounded poll budget for an async count job (an
# archive whose count_target runs async) and the interval between polls, in seconds.
MANNA_COUNT_ASYNC_BUDGET_SECONDS=15.0
MANNA_COUNT_ASYNC_POLL_INTERVAL_SECONDS=1.0

# Optional outbound allow-list. Unset => any *public* host is reachable, which
# keeps search_ivoa_registry discovery working. Private/loopback/link-local space
# is refused either way (see src/manna/_url_guard.py). Set this only for a
# locked-down deployment willing to trade discovery for a tighter blast radius:
# MANNA_ALLOWED_HOSTS=almascience.eso.org,datalab.noirlab.edu
MANNA_ALLOWED_HOSTS=

# Inline-tier response caps. When a tabular result exceeds EITHER limit the server
# does NOT inline every row (it never persists result bytes): a TAP result routes to
# async (mode='auto' re-submits as a job; mode='sync' errors, pointing at async) and
# get_async_job_results hands back a result_url + pyvo fetch_recipe; a cone/SIA result
# truncates inline with truncated=true. Keeps tool results from overflowing a small
# model context. Defaults suit a 64K-token backend; raise for frontier models.
# Presets by model backend:
#   131072-token local backend (e.g. a self-hosted gpt-oss-120b via vLLM):   MANNA_INLINE_ROW_LIMIT=200   MANNA_INLINE_BYTE_LIMIT=49152   (defaults)
#   frontier hosted (Claude, 200K+):   MANNA_INLINE_ROW_LIMIT=2000  MANNA_INLINE_BYTE_LIMIT=262144
MANNA_INLINE_ROW_LIMIT=200
MANNA_INLINE_BYTE_LIMIT=49152   # 48 * 1024
# describe_ivoa_service degrades from per-column detail to a table catalog (names +
# descriptions + column counts) once full introspection would exceed this many bytes.
# Stops a large service (Gaia is ~127k tokens of tables x columns) overflowing the
# model context.
MANNA_REGISTRY_DESCRIBE_BYTE_LIMIT=49152   # 48 * 1024
